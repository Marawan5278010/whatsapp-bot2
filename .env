# ============================================================
# WhatsApp Auto-Reply Bot - Environment Configuration
# ============================================================
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in your values below
# 3. Never commit .env to version control!
# ============================================================

# Required: Your OpenAI API key
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=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

# Required: Your name (used in AI replies so people know who it's for)
USER_NAME=Marwan

# Optional: OpenAI model to use (default: gpt-4o-mini)
# Options: gpt-4o-mini, gpt-3.5-turbo, gpt-4o
OPENAI_MODEL=gpt-4o-mini

# Optional: Maximum tokens per AI reply (default: 300)
MAX_TOKENS=300

# Optional: AI creativity level, 0.0 - 1.0 (default: 0.7)
TEMPERATURE=0.7

# Optional: Max messages to keep in conversation memory (default: 20)
MAX_CONTEXT_MESSAGES=20

# Optional: Reply to ALL incoming messages, not just unknown contacts (default: false)
# Set to "true" if you want the AI to reply to everyone, including saved contacts.
REPLY_TO_ALL=false
